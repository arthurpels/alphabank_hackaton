# Скопируй в .env: cp .env.example .env
# Все значения — демо, для локального запуска. Реальные секреты сюда не пишем.

# PostgreSQL
POSTGRES_USER=alphabank
POSTGRES_PASSWORD=alphabank
POSTGRES_DB=credit_pipeline

# Backend → PostgreSQL (Spring Boot подхватывает SPRING_DATASOURCE_* сам)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/credit_pipeline

# Backend → внутренние сервисы (имена из docker-compose, порты внутри контейнеров)
ML_URL=http://ml:8001
MOCKS_URL=http://mocks:8002

# Frontend → Backend (запросы идут из браузера, поэтому localhost и порт хоста)
VITE_API_URL=http://localhost:8080

# Порты на хосте
BACKEND_PORT=8080
FRONTEND_PORT=5173
ML_PORT=8001
MOCKS_PORT=8002

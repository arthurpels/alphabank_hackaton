# Скопируй в .env: cp .env.example .env
# Все значения — демо, для локального запуска. Реальные секреты сюда не пишем.

# PostgreSQL
POSTGRES_USER=alphabank
POSTGRES_PASSWORD=alphabank
POSTGRES_DB=credit_pipeline

# Backend → PostgreSQL (Spring Boot подхватывает SPRING_DATASOURCE_* сам)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/credit_pipeline

# Backend → внутренние сервисы (имена из docker-compose, порты внутри контейнеров)
ML_URL=http://ml:8001
MOCKS_URL=http://mocks:8002

# Скоринг-сервис → локальная LLM (T27, опционально)
# Включить: LLM_ENABLED=true и запуск с профилем: docker compose --profile llm up
# LLM разбирает цель кредита, когда словарь не может решить; без LLM — словарь и шаблонная сводка.
LLM_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=60
# LLM-сводка андеррайтеру: на CPU с qwen3:4b шаблон точнее и быстрее — включать с GPU и моделью побольше
LLM_SUMMARY_ENABLED=false

# Frontend → Backend (запросы идут из браузера, поэтому localhost и порт хоста)
VITE_API_URL=http://localhost:8080

# Порты на хосте
BACKEND_PORT=8080
FRONTEND_PORT=5173
ML_PORT=8001
MOCKS_PORT=8002

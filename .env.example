# Скопируй в .env: cp .env.example .env
# Все значения — демо, для локального запуска. Реальные секреты сюда не пишем.

# PostgreSQL
POSTGRES_USER=alphabank
POSTGRES_PASSWORD=alphabank
POSTGRES_DB=credit_pipeline

# Backend → PostgreSQL (Spring Boot подхватывает SPRING_DATASOURCE_* сам)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/credit_pipeline

# Backend → внутренние сервисы (имена из docker-compose, порты внутри контейнеров)
ML_URL=http://ml:8001
MOCKS_URL=http://mocks:8002
# Дата первого расчёта заявки (M03); дальнейшие пересчёты и перемотка времени её не меняют
DEMO_DATE=2026-10-23

# Скоринг-сервис → локальная LLM (T27, опционально)
# Включить: LLM_ENABLED=true и запуск с профилем: docker compose --profile llm up
# LLM разбирает цель кредита, когда словарь не может решить; без LLM — словарь и шаблонная сводка.
LLM_ENABLED=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
# Модель закреплена по digest: другая сборка под тем же тегом — LLM не используется (детерминизм, M01)
OLLAMA_MODEL_DIGEST=359d7dd4bcdab3d86b87d73ac27966f4dbb9f5efdfcc75d34a8764a09474fae7
LLM_TIMEOUT_SECONDS=60
# Backend → долгие LLM-эндпоинты ML: таймаут и circuit breaker, без ретраев (M04)
ML_LLM_TIMEOUT_MS=90000
ML_LLM_CIRCUIT_FAILURES=3
ML_LLM_CIRCUIT_OPEN_MS=30000
# Кеш вердиктов LLM (M02): один и тот же вход — один ответ навсегда; лежит на томе ml_llm_cache
LLM_CACHE_PATH=/data/llm-cache/verdicts.sqlite
# Режим replay (M26): ответы модели берутся из записанного файла, Ollama не нужна — для тестов, CI и golden-master.
# Пусто — обычный режим. Пример: LLM_REPLAY_PATH=/app/eval/replay/llm_answers.jsonl
LLM_REPLAY_PATH=
# LLM-сводка андеррайтеру: на CPU с qwen3:4b шаблон точнее и быстрее — включать с GPU и моделью побольше
LLM_SUMMARY_ENABLED=false

# Frontend → Backend (запросы идут из браузера, поэтому localhost и порт хоста)
VITE_API_URL=http://localhost:8080
# false или пусто — фронт ходит в настоящий бэкенд, true — на встроенных моках (данные в памяти вкладки, сбрасываются при обновлении)
VITE_USE_MOCKS=false
# Backend → адреса сайта, с которых браузер может ходить в API (CORS), через запятую.
# Пусто — http://localhost:${FRONTEND_PORT}; задавать, если сайт открывают с другого хоста
CORS_ALLOWED_ORIGINS=

# Порты на хосте
BACKEND_PORT=8080
FRONTEND_PORT=5173
ML_PORT=8001
MOCKS_PORT=8002
